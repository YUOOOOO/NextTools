{
  "id": "com.nexttools.workspace-files",
  "name": "工作区文件",
  "version": "0.1.0",
  "kind": "workspace-tool",
  "platforms": ["windows", "macos", "linux"],
  "mobileMode": "unavailable",
  "capabilities": ["workspace.read"],
  "contributes": {
    "views": ["files"],
    "commands": [
      {
        "id": "open",
        "title": "打开文件浏览器",
        "execution": "foreground",
        "viewId": "files",
        "requiredCapabilities": ["workspace.read"]
      },
      {
        "id": "refresh",
        "title": "刷新文件列表",
        "execution": "background",
        "viewId": null,
        "requiredCapabilities": ["workspace.read"]
      }
    ]
  },
  "runtime": {
    "kind": "host-builtin"
  }
}
