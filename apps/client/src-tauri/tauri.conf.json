{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextTools",
  "version": "0.1.0",
  "identifier": "com.nexttools.desktop",
  "plugins": { "deep-link": { "desktop": { "schemes": ["com.nexttools.client"] }, "mobile": [{ "scheme": ["com.nexttools.mobile"], "appLink": false }] } },
  "build": {
    "beforeDevCommand": "npm --prefix ../../plugins/pi-agent/runner run build && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../../plugins/pi-agent/runner run package:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NextTools",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../../../LICENSE.percho",
    "resources": {
      "../../../plugins/pi-agent/runner/dist/agent-runtime": "agent-runtime"
    }
  }
}
